# ─────────────────────────────────────────────────────────────
# Modèle des variables d'environnement.
# Copier ce fichier en `.env` puis remplacer les valeurs :
#   cp .env.example .env
# Le fichier .env n'est JAMAIS commité (voir .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Base de données PostgreSQL (utilisées par docker-compose.yml) ---
POSTGRES_USER=droguerie
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=droguerie
POSTGRES_PORT=5432

# --- Connexion utilisée par Prisma et par l'application ---
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL="postgresql://droguerie:change-moi@localhost:5432/droguerie"

# --- Compte administrateur initial (créé par `npm run db:seed` s'il n'existe pas) ---
# Le mot de passe n'est utilisé qu'une fois pour créer le compte (12 caractères minimum).
ADMIN_EMAIL=admin@exemple.com
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=change-moi-12-caracteres-min

# --- Données de démonstration (catégories, produits fictifs) ---
# true en développement uniquement. JAMAIS en production.
SEED_DEMO_DATA=false

# --- Images envoyées (photos produits, logo, bannière) ---
# Dossier de stockage. Vide = ./storage/uploads. En production : volume Docker sauvegardé.
UPLOAD_DIR=

# --- Intelligence artificielle (OpenAI) ---
# Clé API du compte OpenAI DU MAGASIN (https://platform.openai.com/api-keys), payé à l'utilisation.
# ≠ abonnement ChatGPT (Plus/Pro), qui ne donne PAS accès à l'API. Vide = IA désactivée.
# Secret : uniquement côté serveur, ne JAMAIS la préfixer par NEXT_PUBLIC_.
OPENAI_API_KEY=
# Modèle utilisé (lit les photos). Liste : https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-6.2-sol
# Modèle de retouche d'image (option « Version OpenAI » du fond studio).
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# --- Détourage local (fond studio fidèle, gratuit) ---
# Dossier du modèle ISNet téléchargé par `npm run ai:model` (≈ 170 Mo). Vide = ./storage/models.
MODELS_DIR=
