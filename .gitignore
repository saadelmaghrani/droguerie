# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets jamais versionnés ; seul le modèle .env.example l'est
.env*
!.env.example

# Images envoyées (photos, logo, bannière) — sauvegardées séparément, jamais dans Git
/storage/

# Prisma — client généré automatiquement (recréé par `prisma generate`)
/src/generated/

# Claude Code — réglages personnels de la machine
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
