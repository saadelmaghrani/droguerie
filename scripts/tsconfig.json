{
  // Scripts lancés hors de Next.js (tsx) : « server-only » (fourni par Next) est remplacé par un module vide.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../src/*"],
      "server-only": ["../src/test/server-only-stub.ts"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts", "../src/**/*.tsx"]
}
